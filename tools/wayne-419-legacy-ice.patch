diff --git a/arch/arm64/configs/wayne_skyward_legacyice.config b/arch/arm64/configs/wayne_skyward_legacyice.config
new file mode 100644
--- /dev/null
+++ b/arch/arm64/configs/wayne_skyward_legacyice.config
@@ -0,0 +1,14 @@
+# Experimental recovery-only compatibility for LOS 18.1 PRIVATE-mode FBE.
+# Merge into the config extracted from the matching Wayne Melon recovery.
+# This does not enable the separate userspace RPMB ioctl compatibility shim.
+CONFIG_ARCH_SDM660=y
+CONFIG_BLK_INLINE_ENCRYPTION=y
+CONFIG_FS_ENCRYPTION=y
+CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
+CONFIG_MMC_CQHCI_CRYPTO=y
+CONFIG_MMC_CQHCI_CRYPTO_QTI=y
+CONFIG_QTI_CRYPTO_COMMON=y
+CONFIG_QTI_CRYPTO_TZ=y
+# CONFIG_SCSI_UFS_CRYPTO_QTI is not set
+CONFIG_ENABLE_LEGACY_PFK=y
+CONFIG_QTI_CRYPTO_TZ_SDM660_LEGACY_ICE=y
