diff --git a/drivers/mmc/host/cqhci-crypto-qti.c b/drivers/mmc/host/cqhci-crypto-qti.c
--- a/drivers/mmc/host/cqhci-crypto-qti.c
+++ b/drivers/mmc/host/cqhci-crypto-qti.c
@@ -31,6 +31,29 @@
 #define MINIMUM_DUN_SIZE 512
 #define MAXIMUM_DUN_SIZE 65536
 
+/* SDM660 PFK firmware reserves slots 0 and 1 for full-disk encryption. */
+#define SDM660_LEGACY_ICE_SLOT_OFFSET \
+	(IS_ENABLED(CONFIG_QTI_CRYPTO_TZ_SDM660_LEGACY_ICE) ? 2 : 0)
+
+static unsigned int cqhci_qti_num_keyslots(struct cqhci_host *host)
+{
+	unsigned int slots = cqhci_num_keyslots(host);
+
+	if (IS_ENABLED(CONFIG_QTI_CRYPTO_TZ_SDM660_LEGACY_ICE)) {
+		slots = min_t(unsigned int, slots, 32);
+		if (slots <= SDM660_LEGACY_ICE_SLOT_OFFSET)
+			return 0;
+		slots -= SDM660_LEGACY_ICE_SLOT_OFFSET;
+	}
+	return slots;
+}
+
+static bool cqhci_qti_keyslot_valid(struct cqhci_host *host,
+				    unsigned int slot)
+{
+	return slot < cqhci_qti_num_keyslots(host);
+}
+
