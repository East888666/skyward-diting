-					 slot, data_unit_mask, crypto_alg_id);
+					 slot + SDM660_LEGACY_ICE_SLOT_OFFSET,
+					 data_unit_mask, crypto_alg_id);
 	if (err)
 		pr_err("%s: failed with error %d\n", __func__, err);
 
@@ -146,12 +170,13 @@
