 	 will configure keys.
 
+config QTI_CRYPTO_TZ_SDM660_LEGACY_ICE
+	bool "Use legacy SDM660 eMMC ICE calls for recovery"
+	depends on ARCH_SDM660 && QTI_CRYPTO_TZ
+	depends on MMC_CQHCI_CRYPTO_QTI && FS_ENCRYPTION_INLINE_CRYPT
+	depends on !SCSI_UFS_CRYPTO_QTI
+	select ENABLE_LEGACY_PFK
+	default n
+	help
+	  Opt in only for SDM660 recovery builds reading legacy PRIVATE-mode
+	  filesystems created by the 4.4 PFK driver. Use the separate key/salt
+	  Trustzone call, reserve slots zero and one, and disable wrapped keys.
+	  This is not the SDM845/UFS legacy interface. Leave disabled for normal
+	  kernels and devices using the modern ICE interface.
+
 config MSM_BAM_DMUX
 	bool "BAM Data Mux Driver"
 	depends on SPS
