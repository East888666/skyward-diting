# File transfer: an MTP function beside adb. Skyward serves the function
# itself; once it has written the descriptors it sets sys.usb.ffs.mtp.ready,
# and with adbd ready too, init binds the two together.
# Some legacy recoveries enable configfs after the fs event has passed.
# The property transition marks the gadget directories as ready.
on property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0

# Recovery starts with ADB alone. Some legacy init trees only start adbd
# from the combined MTP trigger, which leaves the port silent at boot.
on property:sys.usb.config=adb
    start adbd

# Stock init retains ownership of the controller and ADB-only binding.

# The combined mode still starts adbd and binds both FunctionFS functions.
on property:sys.usb.config=mtp,adb
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# MIUI recovery has no none action. Complete teardown before acknowledging
# the state: Skyward waits for both this state and adbd to stop.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    setprop sys.usb.ffs.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    setprop sys.usb.state none
